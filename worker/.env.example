# Référence des variables nécessaires au Worker (worker/strava.js).
# Ce fichier n'est PAS lu automatiquement au déploiement : il documente les noms
# attendus. Les vraies valeurs se déclarent avec `wrangler secret put` (voir README.md),
# jamais dans un fichier versionné.
#
# Pour du développement local avec `wrangler dev`, vous pouvez copier ce fichier
# en `.dev.vars` (déjà ignoré par git) et y mettre vos vraies valeurs.

# Secret — obtenu via setup-token.sh
REFRESH_TOKEN=

# Secret — depuis la page "My API Application" de Strava
CLIENT_SECRET=

# Non secret — l'origine exacte depuis laquelle index.html est servi
ALLOWED_ORIGIN=https://votre-utilisateur.github.io
